# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/affili_ai_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_SERVICE_KEY=your-service-key

# API Configuration
API_BASE_URL=http://localhost:8000
API_KEY_HEADER=Authorization
DEBUG=True

# JWT/Auth
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# Agent Configuration
AGENT_API_KEY=agent-secret-key
AGENT_CLIENT_ID=default-agent

# LLM & Vision Services
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
VISION_PROVIDER=stub  # stub, gemini, openai

# File Storage
STORAGE_PROVIDER=local  # local, supabase
LOCAL_STORAGE_PATH=./uploads

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Deployment
ENVIRONMENT=development
